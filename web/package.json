{
  "name": "forkchoice",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "build": "tsc -b tsconfig.app.json && vite build",
    "dev:mock": "VITE_MOCK=true vite",
    "dev": "vite",
    "generate": "NODE_OPTIONS=--experimental-strip-types NODE_NO_WARNINGS=1 node dataset-generate.ts",
    "generate:api": "openapi-ts",
    "lint:report": "eslint --output-file eslint_report.json --format json src",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test:coverage": "vitest run --coverage",
    "test": "vitest"
  },
  "dependencies": {
    "@headlessui/react": "2.2.10",
    "@heroicons/react": "2.2.0",
    "@tailwindcss/vite": "4.3.0",
    "@tanstack/react-query": "5.75.0",
    "@tanstack/react-router": "1.170.15",
    "clsx": "2.1.1",
    "graphology": "0.26.0",
    "graphology-types": "0.24.8",
    "javascript-time-ago": "2.5.11",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-time-ago": "7.3.3",
    "react-zoom-pan-pinch": "3.7.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hey-api/openapi-ts": "0.98.1",
    "@tanstack/router-plugin": "1.168.18",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/js-yaml": "4.0.9",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/coverage-v8": "4.1.8",
    "@vitest/eslint-plugin": "1.6.19",
    "autoprefixer": "10.4.21",
    "eslint": "10.4.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.6.0",
    "jsdom": "29.1.1",
    "msw": "2.7.5",
    "prettier": "3.8.3",
    "prop-types": "15.8.1",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.1",
    "vite": "8.0.16",
    "vitest": "4.1.8"
  },
  "volta": {
    "node": "23.11.0",
    "npm": "10.9.2"
  },
  "msw": {
    "workerDirectory": "public"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide",
      "msw"
    ]
  }
}
